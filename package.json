{
  "name": "speachy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npx nodemon server.js",
    "dev:client": "cd client && PORT=3001 npm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
